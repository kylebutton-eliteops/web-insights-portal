# One Zscaler OneAPI client, used by every tool in the toolkit. Copy to .env, fill in, restart.
# (Or skip this file and type them once on the dashboard; those are kept in memory only.)
# Vanity domain = the part before .zslogin.net in your ZIdentity sign-in address (e.g. acme).
ZIA_VANITY_DOMAIN=
ZIA_CLIENT_ID=
ZIA_CLIENT_SECRET=

# Optional: legacy ZIA API key instead of OneAPI
# ZIA_USERNAME=
# ZIA_PASSWORD=
# ZIA_API_KEY=
# ZIA_CLOUD=zscalertwo.net
